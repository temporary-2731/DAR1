<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_highlight_card">

    <TextView
        android:id="@+id/param_row_action_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#000000"
        android:padding="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/param_dimension_label"
        android:textSize="12sp"
        android:textColor="#444444" />

    <EditText
        android:id="@+id/edit_dimension"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:textColor="#000000"
        android:textColorHint="#999999" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/param_time_label"
        android:textSize="12sp"
        android:textColor="#444444"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/edit_time_vector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:hint="e.g. 7.00,12.30,19.15" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/param_duration_label"
        android:textSize="12sp"
        android:textColor="#444444"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/edit_duration_vector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:hint="e.g. 30,45,60" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/param_quan1_label"
        android:textSize="12sp"
        android:textColor="#444444"
        android:layout_marginTop="6dp" />

    <EditText
        android:id="@+id/edit_quan1_vector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#999999"
        android:hint="e.g. 5,10,8" />

</LinearLayout>